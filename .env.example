# Copy to .env (gitignored). Values here are for local development only;
# real secrets never live in the repo (AGENTS.md).

NODE_ENV=development

# --- API (apps/api) ---
# Port 3000 is taken on the dev machine, so the API listens on 4000.
API_PORT=4000
# Comma-separated origins allowed by CORS: admin and POS dev servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Signs access tokens. Development value only: production must set its own random secret of at
# least 32 characters (the API refuses to start in production with this one).
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Lifetime of an access token. Short on purpose: permissions are read from the cache on every
# request, the token only proves who is calling.
ACCESS_TOKEN_TTL_SECONDS=900
# Lifetime of a refresh token, renewed on every refresh: a session ends after this long unused.
REFRESH_TOKEN_TTL_SECONDS=604800

# Number of reverse proxies in front of the API (0 locally). Needed to read the client IP
# for the login rate limit; a wrong value lets a client fake its address.
TRUST_PROXY=0
# Login attempts allowed per IP address inside the window, on top of the per-account lockout.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Infrastructure (docker-compose.yml) ---
POSTGRES_USER=fnb
POSTGRES_PASSWORD=fnb_local_dev
POSTGRES_DB=fnb
# Host port 5433: 5432 is used by another project on the dev machine.
POSTGRES_PORT=5433
DATABASE_URL=postgres://fnb:fnb_local_dev@localhost:5433/fnb

# Integration tests (apps/api, `*.int.test.ts`) use the same Postgres server but their own database:
# the name above plus `_test`, dropped and recreated on every run. They use Redis database 15.
# Set TEST_DATABASE_URL / TEST_REDIS_URL only to point them somewhere else.

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fnb-local
S3_ACCESS_KEY=fnb_local
S3_SECRET_KEY=fnb_local_dev_secret

# --- Web apps (Vite reads variables with the VITE_ prefix) ---
VITE_API_URL=http://localhost:4000
