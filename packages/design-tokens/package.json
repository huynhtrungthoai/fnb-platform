{
  "name": "@fnb/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "dev": "node --watch-path=src --watch-path=tokens.json scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fnb/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
