{
  "name": "fnb-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint \"*.mjs\" scripts && node scripts/check-filenames.mjs && node scripts/check-i18n.mjs",
    "lint:fix": "turbo run lint -- --fix && eslint \"*.mjs\" scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@fnb/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
